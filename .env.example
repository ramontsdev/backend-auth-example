# Server
PORT=4500
NODE_VERSION="22.17.1"

# Database

# DATABASE_URL="postgresql://root:root@db:5432/auth_example_db" # docker
DATABASE_URL="postgresql://root:root@localhost:5432/jogos_de_mesa_db"

# Authentication
JWT_SECRET="secret-example"
ALLOWED_ORIGINS="http://localhost:3000" # comma separated list of allowed origins

# AWS (for email sending)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""

# APP CONFIGS
APP_NAME="Jogos de Mesa"
APP_DOMAIN="ramonbuilder.com.br"
APP_EMAIL="info@ramonbuilder.com.br"

# Email
EMAIL_FROM="Jogos de Mesa<info@ramonbuilder.com.br>"
